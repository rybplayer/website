---
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import type { MarkdownHeading } from "astro"

type Section = {
  id?: string
  label: string
  open?: boolean
  headings: MarkdownHeading[]
}
type Props = { title: string; sections: Section[] }

const { title, sections } = Astro.props
---

<nav aria-label="Table of contents" data-toc>
  <button
    type="button"
    aria-expanded="false"
    aria-controls="mobile-table-of-contents"
    data-mobile-toggle
    data-bar
  >
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5"></circle>
      <circle cx="8" cy="8" r="6.5" transform="rotate(-90 8 8)"></circle>
    </svg>
    <toc-current>{title}</toc-current>
    <ChevronIcon aria-hidden="true" />
  </button>

  <div id="mobile-table-of-contents" data-mobile-panel data-bar hidden>
    <ul>
      {sections.map(({ id, label, open, headings }) =>
          id ? (
            <li data-group>
              {headings.length > 0 ? (
                <details open={open || undefined}>
                  <summary>
                    <a href={`#${id}`}>{label}</a>
                    <ChevronIcon aria-hidden="true" />
                  </summary>
                  <ul>
                    {headings.map(({ depth, slug, text }) => (
                      <li data-depth={depth}>
                        <a href={`#${slug}`}>{text}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={`#${id}`}>{label}</a>
              )}
            </li>
          ) : (
            headings.map(({ depth, slug, text }) => (
              <li data-depth={depth}>
                <a href={`#${slug}`}>{text}</a>
              </li>
            ))
          ),
        )}
    </ul>
  </div>

  <div data-toc-rail>
    <ul>
      {sections.map(({ id, label, headings }) => (
          <>
            {id && (
              <li data-depth="1">
                <a href={`#${id}`}><span data-toc-label>{label}</span></a>
              </li>
            )}
            {headings.map(({ depth, slug, text }) => (
              <li
                data-depth={depth}
                data-indent={Math.max(0, depth - 2 + (id ? 1 : 0))}
              >
                <a href={`#${slug}`}><span data-toc-label>{text}</span></a>
              </li>
            ))}
          </>
        ))}
    </ul>
  </div>
</nav>

<style>
  nav {
    font-size: var(--step--1);
  }

  [data-mobile-toggle],
  [data-mobile-panel] {
    display: none;
  }

  @media (width < 64rem) {
    nav {
      position: relative;
    }

    [data-mobile-toggle] {
      appearance: none;
      inline-size: 100%;
      margin: 0;
      border-block-start: 0;
      border-inline: 0;
      border-radius: 0;
      color: inherit;
      font: inherit;
      text-align: start;
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
      cursor: pointer;

      > svg:first-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;

        circle {
          fill: none;
          stroke: var(--border);
          stroke-width: 2;

          &:last-child {
            --circumference: calc(2 * pi * 6.5px);

            stroke: var(--muted-foreground);
            stroke-dasharray: var(--circumference);
            stroke-dashoffset: calc(
              var(--circumference) *
              (1 - var(--progress, 0))
            );
          }
        }
      }

      toc-current {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        color: var(--muted-foreground);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      > svg:last-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;
        color: var(--muted-foreground);
      }
    }

    [data-mobile-toggle]:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    [data-mobile-toggle][aria-expanded="true"] > svg:last-of-type {
      rotate: 180deg;
    }

    [data-mobile-panel] {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      max-block-size: 30svh;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    [data-mobile-panel]:not([hidden]) {
      display: block;
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    a {
      color: var(--muted-foreground);

      &:hover,
      &[data-active] {
        color: var(--foreground);
      }
    }

    li[data-group] {
      font-weight: var(--font-weight-medium);

      &:not(:first-child) {
        margin-block-start: var(--space-2xs);
      }

      summary {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
          display: none;
        }

        a {
          min-inline-size: 0;
        }

        svg {
          flex-shrink: 0;
          inline-size: 1em;
          block-size: 1em;
          margin-inline-start: auto;
          color: var(--muted-foreground);
        }
      }

      details[open] > summary svg {
        rotate: 180deg;
      }

      details > ul {
        --shift: 1;

        margin-block-start: var(--space-3xs);
        font-weight: var(--font-weight-normal);
      }
    }

    li[data-depth] {
      padding-inline-start: calc(
        (var(--shift, 0) + var(--indent, 0)) *
        var(--space-xs)
      );
    }

    li[data-depth="3"] {
      --indent: 1;
    }

    li[data-depth="4"] {
      --indent: 2;
    }
  }

  @property --toc-rail-clip {
    syntax: "<length-percentage>";
    inherits: false;
    initial-value: 0px;
  }

  [data-toc-rail] {
    display: none;
  }

  @media screen and (width >= 64rem) {
    [data-toc-rail] {
      --toc-rail-column: 1.25rem;
      --toc-rail-row: 0.6875rem;
      --toc-rail-open-row: 1.75rem;
      --toc-rail-padding: var(--space-2xs);
      --toc-rail-overflow: 3rem;
      --toc-rail-collapsed-width: calc(
        var(--toc-rail-column) + 2 * var(--toc-rail-padding) + 4px
      );
      --toc-rail-clip: calc(
        100% -
        var(--toc-rail-column) -
        2 *
        var(--toc-rail-padding) -
        4px
      );

      position: fixed;
      inset-block-start: 50%;
      inset-inline-start: calc(var(--grid-edge) - var(--toc-rail-padding));
      z-index: 20;
      display: block;
      width: max-content;
      max-width: min(28rem, calc(100vw - 1.5rem));
      max-height: calc(100svh - 2 * var(--page-offset-top));
      pointer-events: none;
      translate: 0 -50%;

      > ul {
        width: var(--toc-rail-collapsed-width);
        max-width: inherit;
        max-height: inherit;
        padding: var(--toc-rail-padding);
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        border: 2px solid transparent;
        scrollbar-width: none;
        clip-path: inset(
          calc(-1 * var(--toc-rail-overflow)) var(--toc-rail-clip)
            calc(-1 * var(--toc-rail-overflow))
            calc(-1 * var(--toc-rail-overflow))
        );
        pointer-events: auto;
        transition:
          --toc-rail-clip 0.24s cubic-bezier(0.22, 1, 0.36, 1),
          background-color 0.18s ease,
          border-color 0.18s ease,
          box-shadow 0.18s ease;

        &::-webkit-scrollbar {
          display: none;
        }
      }

      a {
        --toc-tick: 0.625rem;

        display: grid;
        grid-template-columns: var(--toc-rail-column) minmax(0, 1fr);
        align-items: center;
        column-gap: var(--space-2xs);
        height: var(--toc-rail-row);
        overflow: hidden;
        color: var(--muted-foreground);
        text-decoration: none;
        transition:
          height 0.24s cubic-bezier(0.22, 1, 0.36, 1),
          color 0.18s ease;

        &::before {
          content: "";
          inline-size: var(--toc-tick);
          block-size: 2px;
          border-radius: var(--radius-full);
          background: currentColor;
          opacity: 0.45;
          transition: opacity 0.18s ease;
        }

        &:hover,
        &[data-active] {
          color: var(--foreground);

          &::before {
            opacity: 1;
          }
        }
      }

      li[data-depth="1"] a,
      li[data-depth="4"] a {
        --toc-tick: 1.25rem;
      }

      li[data-depth="3"] a {
        --toc-tick: 0.9375rem;
      }

      [data-toc-label] {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        opacity: 0;
        padding-inline-start: calc(
          var(--toc-label-indent, 0) *
          var(--space-xs)
        );
        transition: opacity 0.16s ease;
      }

      li[data-indent="1"] {
        --toc-label-indent: 1;
      }

      li[data-indent="2"] {
        --toc-label-indent: 2;
      }

      li[data-indent="3"] {
        --toc-label-indent: 3;
      }

      &:hover > ul,
      &:focus-within > ul {
        --toc-rail-clip: calc(-1 * var(--toc-rail-overflow));

        width: max-content;
        border-color: var(--border);
        background: var(--background);
        box-shadow: 0 16px 32px color-mix(in oklab, black 20%, transparent);

        a {
          height: var(--toc-rail-open-row);
        }

        [data-toc-label] {
          opacity: 1;
        }
      }

      &[data-edge] {
        inset-inline-start: calc(12px - var(--toc-rail-padding) - 2px);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-rail] > ul,
    [data-toc-rail] a,
    [data-toc-label] {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  import { hashId } from "@/lib/utils"

  const nav = document.querySelector<HTMLElement>("nav[data-toc]")
  if (nav) {
    const mobile = matchMedia("(width < 64rem)")
    const ring = nav.querySelector<SVGElement>("[data-mobile-toggle] svg")
    const mobilePanel = nav.querySelector<HTMLElement>("[data-mobile-panel]")
    const rail = nav.querySelector<HTMLElement>("[data-toc-rail]")
    const railList = rail?.querySelector<HTMLElement>(":scope > ul")
    const currentLabel = nav.querySelector("toc-current")
    const toggle = nav.querySelector<HTMLButtonElement>("[data-mobile-toggle]")
    const articles = document.querySelectorAll("main article")

    const progress = () => {
      if (!ring || !mobile.matches) return
      const maximum = document.documentElement.scrollHeight - innerHeight
      ring.style.setProperty(
        "--progress",
        String(maximum > 0 ? Math.min(scrollY / maximum, 1) : 0),
      )
    }

    const targetLinks = new Map<Element, HTMLAnchorElement[]>()
    for (const list of nav.querySelectorAll<HTMLElement>(
      "[data-mobile-panel] > ul, [data-toc-rail] > ul",
    )) {
      const seen = new Map<string, number>()
      for (const link of list.querySelectorAll<HTMLAnchorElement>(
        "a[href^='#']",
      )) {
        const id = hashId(link.hash)
        const occurrence = seen.get(id) ?? 0
        seen.set(id, occurrence + 1)
        const target = document.querySelectorAll(`[id="${CSS.escape(id)}"]`)[
          occurrence
        ]
        if (!target) continue
        const links = targetLinks.get(target)
        if (links) links.push(link)
        else targetLinks.set(target, [link])
      }
    }

    const blockTargets = new Map<Element, Element>()
    for (const target of targetLinks.keys()) {
      const block = target.closest("prose-content > *, article[data-url]")
      if (block && !blockTargets.has(block)) blockTargets.set(block, target)
    }

    const sectionTargets = new Map<Element, Element>()
    for (const article of articles) {
      let current = blockTargets.get(article)
      for (const child of article.children) {
        if (child.tagName === "PROSE-CONTENT") {
          for (const block of child.children) {
            current = blockTargets.get(block) ?? current
            if (current) sectionTargets.set(block, current)
          }
        } else if (current) sectionTargets.set(child, current)
      }
    }

    const centerList = (list: HTMLElement | null | undefined) => {
      if (!list?.checkVisibility()) return
      const active = [
        ...list.querySelectorAll<HTMLAnchorElement>("a[data-active]"),
      ]
      const first = active[0]
      const last = active.at(-1)
      if (!first || !last) return
      const area = list.getBoundingClientRect()
      const midpoint =
        (first.getBoundingClientRect().top +
          last.getBoundingClientRect().bottom) /
        2
      list.scrollTo({
        top: list.scrollTop + midpoint - (area.top + area.height / 2),
      })
    }

    const setMobileOpen = (open: boolean) => {
      if (!toggle || !mobilePanel) return
      toggle.setAttribute("aria-expanded", String(open))
      mobilePanel.hidden = !open
      if (open) centerList(mobilePanel)
    }

    toggle?.addEventListener("click", () => {
      setMobileOpen(toggle.getAttribute("aria-expanded") !== "true")
    })
    mobilePanel?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setMobileOpen(false)
    })

    const visible = new Set<Element>()
    const fallback = currentLabel?.textContent ?? ""
    const scrollPadding =
      Number.parseFloat(
        getComputedStyle(document.documentElement).scrollPaddingBlockStart,
      ) || 0
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target)
          else visible.delete(entry.target)
        }

        const activeTargets = new Set<Element>()
        for (const block of visible) {
          const target = sectionTargets.get(block)
          if (target) activeTargets.add(target)
        }

        let firstActive: HTMLAnchorElement | undefined
        for (const [target, links] of targetLinks) {
          const active = activeTargets.has(target)
          for (const link of links) {
            link.toggleAttribute("data-active", active)
            link.removeAttribute("aria-current")
            if (active && !firstActive && link.checkVisibility())
              firstActive = link
          }
        }
        firstActive?.setAttribute("aria-current", "location")
        if (currentLabel) {
          currentLabel.textContent =
            firstActive?.textContent?.trim() || fallback
        }
        centerList(mobilePanel)
        centerList(railList)
      },
      { rootMargin: `-${scrollPadding}px 0px 0px` },
    )
    for (const block of sectionTargets.keys()) observer.observe(block)

    const updateRailEdge = () => {
      if (!rail || mobile.matches) {
        rail?.removeAttribute("data-edge")
        return
      }
      const navigation = document.querySelector(
        "page-nav sidebar-inner > nav > ul",
      )
      const actions = document.querySelector("page-nav sidebar-toggle")
      if (!navigation || !actions) return
      const box = rail.getBoundingClientRect()
      const upper = navigation.getBoundingClientRect().bottom + 8
      const lower = actions.getBoundingClientRect().top - 8
      rail.toggleAttribute("data-edge", box.top < upper || box.bottom > lower)
    }

    const railResize = new ResizeObserver(updateRailEdge)
    const sidebar = document.querySelector("page-nav aside")
    if (sidebar) railResize.observe(sidebar)
    railResize.observe(document.documentElement)
    addEventListener("scroll", progress, { passive: true })
    addEventListener("resize", updateRailEdge, { passive: true })
    mobile.addEventListener("change", () => {
      if (!mobile.matches) setMobileOpen(false)
      progress()
      updateRailEdge()
    })
    progress()
    updateRailEdge()
  }
</script>
