---
import { readingTime } from "@/lib/content"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Post = CollectionEntry<"blog">
type Props = { post: Post; entries?: Post[] }

const { post, entries = [post] } = Astro.props
const authors = await getEntries(post.data.authors)
const cardImage = post.data.previewImage ?? post.data.image
const lightCardImage = post.data.image
const darkCardImage = post.data.previewImage
---

<li>
  {cardImage && (
      <a href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
        {lightCardImage && darkCardImage ? (
          <>
            <Image data-card-theme="light" src={lightCardImage} alt="" width={640} height={336} />
            <Image data-card-theme="dark" src={darkCardImage} alt="" width={640} height={336} />
          </>
        ) : (
          <Image src={cardImage} alt="" width={640} height={336} />
        )}
      </a>
    )}
  <entry-info>
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={post.data.date.toISOString()}
        >{formatDate(post.data.date)}</time
      >
      <span>· {readingTime(entries)}</span>
      {post.data.tags && (
          <entry-tags>
            {post.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </entry-tags>
        )}
    </entry-meta>
    <p>{post.data.description}</p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;
      overflow: hidden;
      background-color: var(--accent);

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }

      [data-card-theme="dark"] {
        display: none;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;

          a {
            color: inherit;
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        entry-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--space-3xs);

          span {
            color: color-mix(
              in oklab,
              var(--muted-foreground) 50%,
              transparent
            );
          }
        }

        time ~ entry-tags::before {
          content: "·";
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }

  @media (prefers-color-scheme: dark) {
    [data-card-theme="light"] {
      display: none;
    }
    [data-card-theme="dark"] {
      display: block;
    }
  }

  :global(:root[data-theme="light"]) [data-card-theme="light"] {
    display: block;
  }
  :global(:root[data-theme="light"]) [data-card-theme="dark"] {
    display: none;
  }
  :global(:root[data-theme="dark"]) [data-card-theme="light"] {
    display: none;
  }
  :global(:root[data-theme="dark"]) [data-card-theme="dark"] {
    display: block;
  }
</style>
