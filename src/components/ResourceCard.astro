---
import ExternalIcon from "@/assets/icons/external.svg"
import { readingTime } from "@/lib/content"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { resource: CollectionEntry<"resources"> }

const { resource } = Astro.props
const externalOnly = Boolean(resource.data.link && !resource.body?.trim())
const href = externalOnly ? resource.data.link! : `/resources/${resource.id}`
const image = resource.data.previewImage ?? resource.data.image
---

<li>
  {image && (
    <a href={href} tabindex="-1" aria-hidden="true">
      <Image src={image} alt="" width={640} height={336} />
    </a>
  )}
  <entry-info>
    <a
      href={href}
      target={externalOnly ? "_blank" : undefined}
      rel={externalOnly ? "noopener noreferrer" : undefined}
    >
      {resource.data.title}
      {externalOnly && <ExternalIcon aria-hidden="true" />}
    </a>
    <entry-meta>
      <time datetime={resource.data.date.toISOString()}
        >{formatDate(resource.data.date)}</time
      >
      {!externalOnly && <span>· {readingTime(resource)}</span>}
      {resource.data.tags?.map((tag) => <span>#{tag}</span>)}
    </entry-meta>
    <p>{resource.data.description}</p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }
  li > a {
    flex-shrink: 0;
    inline-size: 14rem;
  }
  li > a :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
  entry-info {
    display: flex;
    flex-direction: column;
  }
  entry-info > a {
    display: flex;
    gap: var(--space-3xs);
    align-items: center;
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
  }
  entry-info > a :global(svg) {
    inline-size: 1em;
    block-size: 1em;
  }
  entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-end: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
  entry-meta span:last-child {
    color: color-mix(in oklab, var(--muted-foreground) 60%, transparent);
  }
  p {
    color: var(--muted-foreground);
  }
  @media (width < 40rem) {
    li {
      flex-direction: column;
    }
    li > a {
      inline-size: 100%;
      max-inline-size: 32rem;
    }
  }
</style>
