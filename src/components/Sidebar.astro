---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) =>
    pathname === normalizePath(href) ||
    pathname.startsWith(`${normalizePath(href)}/`),
)
---

<aside data-bar data-site-navigation>
  <sidebar-inner>
    <sidebar-brand>
      <a href="/" aria-label={SITE.title}>
        <Logo />
        <span>{SITE.title}</span>
      </a>
      <button
        type="button"
        data-mobile-menu-toggle
        data-icon-button
        aria-expanded="false"
        aria-controls="site-navigation-menu"
        aria-label="Open site navigation"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </sidebar-brand>
    <mobile-menu id="site-navigation-menu">
      <nav aria-label="Primary navigation">
        <ul>
          {NAVIGATION.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    pathname === normalizePath(item.href) ? "page" : undefined
                  }
                >
                  {item.label}
                </a>
                {item === section &&
                  crumbs.length > 0 &&
                  pathname !== normalizePath(item.href) && (
                  <ul>
                    {crumbs.map((crumb, i) => (
                      <li data-depth={i ? 1 : undefined}>
                        <a
                          href={crumb.href}
                          aria-current={
                            i === crumbs.length - 1 ? "page" : undefined
                          }
                        >
                          {crumb.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          {!section &&
              crumbs.map((crumb, i) => (
                <li data-depth={i ? 1 : undefined}>
                  <a
                    href={crumb.href}
                    aria-current={
                      i === crumbs.length - 1 ? "page" : undefined
                    }
                  >
                    {crumb.label}
                  </a>
                </li>
              ))}
        </ul>
      </nav>
    </mobile-menu>
    <sidebar-toggle>
      <ThemeToggle />
      <slot name="actions" />
    </sidebar-toggle>
  </sidebar-inner>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width >= 48rem) {
      --bar-border-image: none;
      padding: 0;
      background-color: transparent;
      backdrop-filter: none;
      border-block-end: none;
    }

    @media (width < 48rem) {
      position: relative;
      top: auto;
      height: auto;
      padding-block: var(--space-3xs);
    }
  }

  sidebar-inner {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: space-between;

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;

      svg {
        inline-size: auto;
        block-size: 1.5rem;
        flex-shrink: 0;
      }

      span {
        white-space: nowrap;
      }
    }
  }

  [data-mobile-menu-toggle] {
    display: none;
    color: var(--foreground);

    path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      transform-origin: center;
      transition:
        rotate 0.18s ease,
        opacity 0.18s ease;
    }
  }

  mobile-menu {
    display: block;
  }

  @media (width < 48rem) {
    sidebar-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 0;
    }

    sidebar-brand {
      display: contents;

      > a span {
        display: none;
      }

      > a {
        grid-column: 1;
      }

      [data-mobile-menu-toggle] {
        display: inline-flex;
        grid-column: 3;
        margin-inline-end: -0.5rem;
      }
    }

    sidebar-inner:not([data-menu-open]) mobile-menu {
      display: none;
    }

    mobile-menu {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      z-index: 20;
      max-block-size: calc(100svh - var(--bar-nav-height));
      padding-block: var(--space-2xs);
      padding-inline: var(--bar-gutter);
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: color-mix(in oklab, var(--background) 94%, transparent);
      backdrop-filter: blur(var(--blur-sm));
      border-block-end: 2px solid var(--border);
    }

    sidebar-inner[data-menu-open] [data-mobile-menu-toggle] {
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 48rem) {
      gap: 0;

      > li > a {
        padding-block: var(--space-3xs);
        color: var(--foreground);
        font-size: var(--step-0);
      }

      ul {
        display: none;
      }
    }
  }

  nav li:has(> ul) > a {
    @media (width < 48rem) {
      color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-block-start: auto;
    margin-inline-start: -0.5rem;

    @media (width < 48rem) {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      margin: 0;
    }
  }
</style>

<script>
  const sidebar = document.querySelector<HTMLElement>(
    "[data-site-navigation] sidebar-inner",
  )
  const toggle = sidebar?.querySelector<HTMLButtonElement>(
    "[data-mobile-menu-toggle]",
  )
  const menu = sidebar?.querySelector<HTMLElement>("mobile-menu")
  const mobile = matchMedia("(width < 48rem)")

  const setOpen = (open: boolean) => {
    if (!sidebar || !toggle) return
    sidebar.toggleAttribute("data-menu-open", open)
    toggle.setAttribute("aria-expanded", String(open))
    toggle.setAttribute(
      "aria-label",
      open ? "Close site navigation" : "Open site navigation",
    )
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true")
  })

  menu?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) setOpen(false)
  })

  document.addEventListener("click", (event) => {
    if (
      mobile.matches &&
      sidebar?.hasAttribute("data-menu-open") &&
      !(event.target as Element).closest("[data-site-navigation]")
    )
      setOpen(false)
  })

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !sidebar?.hasAttribute("data-menu-open"))
      return
    setOpen(false)
    toggle?.focus()
  })

  mobile.addEventListener("change", () => setOpen(false))
</script>
