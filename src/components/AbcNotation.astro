---
const {
  abc,
  instrument = "guitar",
  staffWidth = 270,
  minWidthPx = 200,
  maxWidthPx = 600,
  maxWidthPercent = "50",
  tuning = '["E,", "A,", "D", "G", "B", "e"]',
} = Astro.props
---

<div
  class="abc-wrapper"
  style={`--abc-min:${minWidthPx}px;--abc-preferred:${parseInt(maxWidthPercent)}%;--abc-max:${maxWidthPx}px`}
>
  <abc-notation
    data-abc={abc}
    data-instrument={instrument}
    data-staffwidth={staffWidth}
    data-tuning={tuning}
  ></abc-notation>
</div>

<style>
  .abc-wrapper {
    inline-size: clamp(var(--abc-min), var(--abc-preferred), var(--abc-max));
    max-inline-size: 100%;
    margin-inline: auto;
    overflow-x: auto;
  }
</style>

<script>
  import abcjs from "abcjs"

  class AbcNotation extends HTMLElement {
    connectedCallback() {
      const abc = this.dataset.abc || ""
      const instrument = this.dataset.instrument
      const staffWidth = parseInt(this.dataset.staffwidth || "150")
      const tuning = JSON.parse(this.dataset.tuning || "[]")
      const options: any = {
        selectionColor: "default",
        responsive: "resize",
        expandToWidest: true,
        staffwidth: staffWidth,
      }

      if (instrument === "guitar") {
        options.tablature = [
          {
            instrument: "guitar",
            tuning: tuning,
          },
        ]
      }

      abcjs.renderAbc(this, abc, options)
    }
  }

  if (!customElements.get("abc-notation"))
    customElements.define("abc-notation", AbcNotation)
</script>
