---
import ExternalIcon from "@/assets/icons/external.svg"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

type Talk = {
  title: string
  description?: string
  githubUrl: string
  date: string
  previewImage?: ImageMetadata
}
type Props = { talk: Talk }
const { talk } = Astro.props
---

<li>
  {talk.previewImage && <a href={talk.githubUrl} tabindex="-1" aria-hidden="true"><Image src={talk.previewImage} alt="" width={640} height={336} /></a>}
  <entry-info>
    <a href={talk.githubUrl} target="_blank" rel="noopener noreferrer"
      >{talk.title}<ExternalIcon aria-hidden="true" /></a
    >
    <time datetime={new Date(talk.date).toISOString()}
      >{formatDate(new Date(talk.date))}</time
    >
    {talk.description && <p>{talk.description}</p>}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }
  li > a {
    flex-shrink: 0;
    inline-size: 14rem;
  }
  li > a :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
  entry-info {
    display: flex;
    flex-direction: column;
  }
  entry-info > a {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
  }
  entry-info > a :global(svg) {
    inline-size: 1em;
    block-size: 1em;
  }
  time {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    margin-block-end: var(--space-3xs);
  }
  p {
    color: var(--muted-foreground);
  }
  @media (width < 40rem) {
    li {
      flex-direction: column;
    }
    li > a {
      inline-size: 100%;
      max-inline-size: 32rem;
    }
  }
</style>
