---
import Link from '@/components/Link.astro'
import { cardVariants } from '@/lib/card-variants'
import { cn } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

type Talk = {
  title: string
  description?: string
  previewImage?: ImageMetadata
  githubUrl: string
  date: string
}

interface Props {
  talk: Talk
  disableHover?: boolean
}

const { talk, disableHover = false } = Astro.props
---

<div
  class={cn(
    cardVariants({
      variant: 'default',
      hover: disableHover ? 'disabled' : 'enabled',
    }),
  )}
>
  <Link href={talk.githubUrl} class="flex flex-col gap-4 sm:flex-row" external>
    {
      talk.previewImage && (
        <div class="w-full border sm:max-w-3xs sm:shrink-0">
          <Image
            src={talk.previewImage}
            alt={talk.title}
            width={1200}
            widths={[128, 256, 512]}
            height={630}
            class="object-cover"
          />
        </div>
      )
    }
    <div class="grow">
      <h3 class="mb-1 text-lg font-semibold">{talk.title}</h3>
      {talk.description && (
        <p class="text-muted-foreground mb-2 text-sm">{talk.description}</p>
      )}
    </div>
  </Link>
</div>

