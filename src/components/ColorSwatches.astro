---
import { colors, type ColorName, type Theme } from "@/lib/colors"
type Props = { theme: Theme }
const { theme } = Astro.props
const themeColors = colors[theme]
const names = Object.keys(themeColors) as ColorName[]
---

<color-swatches
  style={`--swatch-background:${themeColors.background};--swatch-foreground:${themeColors.foreground};--swatch-muted:${themeColors.muted}`}
>
  {names.map((name) => <color-swatch><i style={`background:${themeColors[name]}`}></i><strong>{name}</strong><code>{themeColors[name]}</code></color-swatch>)}
</color-swatches>

<style>
  color-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-s);
    padding: var(--space-s);
    color: var(--swatch-foreground);
    background-color: var(--swatch-background);
    border-radius: var(--radius-lg);
  }
  color-swatch {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  i {
    display: block;
    aspect-ratio: 4;
    border-radius: var(--radius-sm);
  }
  strong {
    color: var(--swatch-foreground);
    font-size: var(--step--1);
  }
  code {
    overflow-wrap: anywhere;
    color: var(--swatch-foreground);
    background-color: var(--swatch-muted);
    font-size: 0.65rem;
  }
</style>
