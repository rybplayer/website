---
import { SITE } from '@/consts'
import { getParentPost, isSubpost, type ContentCollection } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<ContentCollection>
  collection?: ContentCollection
}

const { post, collection = 'blog' } = Astro.props

const parentPost = isSubpost(post.id)
  ? await getParentPost(post.id, collection)
  : null

const title = post.data.title || SITE.title
const description =
  post.data.description || parentPost?.data.description || SITE.description
const image = new URL('/static/1200x630.webp', Astro.site)
const author =
  post.data.authors && post.data.authors.length > 0
    ? post.data.authors.join(', ')
    : SITE.author

let ogImage = image
if (post?.data?.previewImage?.src) {
  ogImage = new URL(`${SITE.href}${post.data.previewImage.src}`, Astro.site)
} else if (post?.data?.image?.src) {
  ogImage = new URL(`${SITE.href}${post.data.image.src}`, Astro.site)
} else if (parentPost?.data?.previewImage?.src) {
  ogImage = new URL(
    `${SITE.href}${parentPost.data.previewImage.src}`,
    Astro.site,
  )
} else if (parentPost?.data?.image?.src) {
  ogImage = new URL(`${SITE.href}${parentPost.data.image.src}`, Astro.site)
}
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={SITE.href} />

{isSubpost(post.id) && <meta name="robots" content="noindex" />}

{/* Preload LCP image for better performance */}
{
  post?.data?.image?.src && (
    <link
      rel="preload"
      as="image"
      href={post.data.image.src}
      fetchpriority="high"
    />
  )
}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={Astro.url} />
<meta property="og:author" content={author} />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}
