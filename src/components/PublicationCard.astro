---
import { assertLinkIconAsset, linkIconForUrl } from "@/lib/link-icons"
import { formatDate, formatMonthYear } from "@/lib/utils"
import type { CollectionEntry } from "astro:content"

type Publication = CollectionEntry<"publications">
type PublicationLink = Publication["data"]["links"][number]
type PublicationLinkKind = PublicationLink["kind"]
type Props = { publication: Publication }

const { publication } = Astro.props
const data = publication.data
const titleParts = data.title.split(/(-)/u)
const linkOrder: PublicationLinkKind[] = [
  "conference",
  "paper",
  "preprint",
  "code",
  "slides",
]
const links = data.links.toSorted(
  (a, b) => linkOrder.indexOf(a.kind) - linkOrder.indexOf(b.kind),
)
const primaryHref =
  links.find(({ kind, href }) => kind === "paper" && href)?.href ??
  links.find(({ kind, href }) => kind === "preprint" && href)?.href

const linkLabel = ({ kind, label }: PublicationLink) =>
  label ?? kind.charAt(0).toUpperCase() + kind.slice(1)
const dateLabel =
  data.datePrecision === "year"
    ? String(data.date.getUTCFullYear())
    : data.datePrecision === "month"
      ? formatMonthYear(data.date)
      : formatDate(data.date)
const iconStyle = (href: string) =>
  `--publication-icon:url("${assertLinkIconAsset(linkIconForUrl(href))}")`
const isExternal = (href: string) => /^https?:\/\//.test(href)
---

<li>
  <article>
    <h2>
      {primaryHref ? (
        <a href={primaryHref} target="_blank" rel="noopener noreferrer">
          {titleParts.map((part) => <>{part}{part === "-" && <wbr />}</>)}
        </a>
      ) : (
        titleParts.map((part) => <>{part}{part === "-" && <wbr />}</>)
      )}
    </h2>
    <publication-meta>
      <time datetime={data.date.toISOString()}>
        {dateLabel}
      </time>
      <span aria-hidden="true">·</span>
      <publication-authors>
        {data.authors.map((author, index) => (
          <>
            {index > 0 && ", "}
            {author.name === "Ryan Batubara" ? (
              <strong>
                {author.href ? (
                  <a
                    href={author.href}
                    target={isExternal(author.href) ? "_blank" : undefined}
                    rel={isExternal(author.href) ? "noopener noreferrer" : undefined}
                  >
                    {author.name}
                  </a>
                ) : (
                  author.name
                )}
              </strong>
            ) : author.href ? (
              <a href={author.href} target="_blank" rel="noopener noreferrer">
                {author.name}
              </a>
            ) : (
              author.name
            )}
          </>
        ))}
      </publication-authors>
    </publication-meta>
    <p>
      {data.description}
      {data.adviser && (
        <>
          {" "}Advised by <a
            href={data.adviser.href}
            target="_blank"
            rel="noopener noreferrer"
          >{data.adviser.name}</a>.
        </>
      )}
    </p>
    <publication-links aria-label={`Links for ${data.title}`}>
      {links.map((link) =>
        link.href ? (
          <a
            class:list={{ conference: link.kind === "conference" }}
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span
              class="publication-icon"
              style={iconStyle(link.href)}
              aria-hidden="true"
            />
            {linkLabel(link)}
          </a>
        ) : (
          <span class:list={{ conference: link.kind === "conference" }}>
            <span class="status-icon" aria-hidden="true" />
            {linkLabel(link)}
          </span>
        ),
      )}
    </publication-links>
  </article>
</li>

<style>
  article {
    display: flex;
    flex-direction: column;
  }

  h2 {
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    text-wrap: wrap;
  }

  publication-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs);
    margin-block-end: var(--space-3xs);
    color: var(--muted-foreground);
    font-size: var(--font-size-subtext);
  }

  publication-authors {
    strong {
      color: var(--foreground);
      font-weight: var(--font-weight-medium);
    }

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--foreground);
        text-decoration: underline;
      }
    }
  }

  p {
    color: var(--muted-foreground);

    a {
      text-decoration: underline;
    }
  }

  publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-2xs);
    font-size: var(--font-size-subtext);
  }

  publication-links > :is(a, span) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding-inline: var(--space-2xs);
    color: var(--accent-foreground);
    background-color: var(--accent);
    border-radius: var(--radius-full);
    text-decoration: none;
  }

  publication-links > a:hover {
    color: var(--foreground);
  }

  publication-links > .conference {
    color: var(--tag-foreground);
    background-color: var(--tag-background);
  }

  .publication-icon {
    inline-size: 0.75em;
    block-size: 0.75em;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask: var(--publication-icon) center / contain no-repeat;
    mask: var(--publication-icon) center / contain no-repeat;
  }

  .status-icon {
    inline-size: 0.45em;
    block-size: 0.45em;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: currentColor;
  }
</style>
