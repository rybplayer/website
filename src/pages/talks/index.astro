---
import TalkCard from '@/components/TalkCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import talksData from '@/content/talks/talks.json'
import type { ImageMetadata } from 'astro'

type TalkData = {
  slug: string
  title: string
  description?: string
  previewImage?: string
  githubUrl: string
  date: string
}

const images = import.meta.glob('/src/content/talks/media/*', {
  eager: true,
  import: 'default',
})

const talkItems = ((talksData as { items?: TalkData[] }).items ?? [])
const talks = talkItems
  .map(({ previewImage, ...rest }) => {
    if (!previewImage) {
      return { ...rest }
    }

    const resolvedImage = images[
      `/src/content/talks/media/${previewImage}`
    ] as ImageMetadata | undefined

    return resolvedImage ? { ...rest, previewImage: resolvedImage } : { ...rest }
  })
  .sort(
    (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
  )
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Talks" />

  <section>
    <div class="min-w-full">
      <h2 class="mb-4 text-2xl font-medium">Talks</h2>
      <div class="flex flex-col gap-4">
        {talks.map((talk) => (
          <TalkCard talk={talk} />
        ))}
      </div>
    </div>
  </section>
</Layout>
