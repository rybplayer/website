---
import MetaPage from "@/components/MetaPage.astro"
import TalkCard from "@/components/TalkCard.astro"
import Layout from "@/layouts/Layout.astro"
import talksData from "@/content/talks/talks.json"
import type { ImageMetadata } from "astro"

type TalkData = {
  slug: string
  title: string
  description?: string
  previewImage?: string
  githubUrl: string
  date: string
}
const images = import.meta.glob("/src/content/talks/media/*", {
  eager: true,
  import: "default",
})
const talks = ((talksData as { items?: TalkData[] }).items ?? [])
  .map(({ previewImage, ...talk }) => {
    const image = previewImage
      ? (images[`/src/content/talks/media/${previewImage}`] as
          | ImageMetadata
          | undefined)
      : undefined
    return image ? { ...talk, previewImage: image } : talk
  })
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
---

<Layout crumbs={[{ label: "Talks", href: "/talks" }]}>
  <MetaPage slot="head" title="Talks" />
  <h1>Talks</h1>
  <ul>
    {talks.map((talk) => <TalkCard talk={talk} />)}
  </ul>
</Layout>

<style>
  h1 {
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    margin-block-end: var(--space-m);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
