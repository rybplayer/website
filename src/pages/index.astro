---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import SocialIcons from "@/components/SocialIcons.astro"
import { SITE, SOCIALS } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getProjects } from "@/lib/content"

const posts = (await getPosts()).slice(0, SITE.featuredPostCount)
const projects = (await getProjects()).slice(0, SITE.featuredProjectCount)
---

<Layout>
  <MetaPage slot="head" />
  <section class="intro" aria-labelledby="intro-title">
    <img
      src="/static/profile_picture.webp"
      alt="Ryan Batubara"
      width="512"
      height="512"
      fetchpriority="high"
    >
    <intro-copy>
      <intro-heading>
        <h1 id="intro-title">Hi, I'm Ryan!</h1>
        <p>rbatubara at ucsd.edu</p>
      </intro-heading>
      <p>
        I'm a
        <a
          href="https://math.ucsd.edu/students/undergraduate/ma30-math-computer-science-b-s/"
          >Math-CS</a
        >
        and <a href="https://datascience.ucsd.edu/">Data Science</a>
        undergraduate at <a href="https://ucsd.edu/">UCSD</a>. I'm applying to
        MS/PhD programs in Computer Science, specifically in
        <a href="https://dandu.dev/docs/quantum-type-theory.pdf"
          >Quantum Computing</a
        >. My other research interests include
        <a href="https://arxiv.org/pdf/2502.12428"
          >GPU-based computational algebra</a
        >
        and <a href="https://github.com/rybplayer/Talks">recreational math</a>.
      </p>
      <intro-actions>
        <document-links>
          <a
            class="document-link"
            href="https://github.com/rybplayer/CV/blob/2fe395833ebbd594804631cdd80e7852d25e82ae/RyanBatubaraCV.pdf"
            >CV</a
          >
          <a
            class="document-link"
            href="https://github.com/rybplayer/Resume/blob/main/RyanBatubaraResume.pdf"
            >Resume</a
          >
        </document-links>
        <SocialIcons links={SOCIALS} />
      </intro-actions>
    </intro-copy>
  </section>

  {projects.length > 0 && (
    <section class="listing" aria-labelledby="projects-title">
      <listing-heading>
        <h2 id="projects-title">Latest project</h2>
        <a href="/projects">See all projects →</a>
      </listing-heading>
      <ul>{projects.map((project) => <ProjectCard project={project} />)}</ul>
    </section>
  )}

  {posts.length > 0 && (
    <section class="listing" aria-labelledby="posts-title">
      <listing-heading>
        <h2 id="posts-title">Latest blog post</h2>
        <a href="/blog">See all posts →</a>
      </listing-heading>
      <ul>{posts.map((post) => <BlogCard post={post} />)}</ul>
    </section>
  )}
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr;
    gap: var(--space-m);
    align-items: start;
  }

  .intro > img {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  intro-copy,
  intro-heading,
  intro-actions,
  listing-heading {
    display: flex;
  }

  intro-copy {
    flex-direction: column;
    gap: var(--space-s);
    color: var(--muted-foreground);
  }

  intro-heading {
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
  }

  h1 {
    color: var(--foreground);
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
  }

  intro-heading p,
  listing-heading a {
    font-size: var(--step--1);
  }

  intro-actions {
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    inline-size: 100%;
  }

  document-links {
    display: flex;
    gap: var(--space-2xs);
  }

  intro-actions :global(ul) {
    margin-inline-start: auto;
  }

  intro-copy > p a,
  .document-link {
    --underline: currentColor;
    color: inherit;
    font-weight: inherit;
  }

  .listing {
    margin-block-start: var(--space-xl);
  }

  listing-heading {
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
  }

  h2 {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  @media (width < 32rem) {
    .intro {
      grid-template-columns: 6rem 1fr;
    }

    intro-copy {
      display: contents;
    }

    intro-copy > p,
    intro-actions {
      grid-column: 1 / -1;
    }
  }
</style>
