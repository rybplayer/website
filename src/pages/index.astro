---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import PublicationCard from "@/components/PublicationCard.astro"
import SocialIcons from "@/components/SocialIcons.astro"
import { SOCIALS } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getPublications, getSubposts } from "@/lib/content"

const featuredPost = (await getPosts()).find(
  ({ id }) => id === "functional-python",
)
const publications = await getPublications()
const featuredPublication = publications.find(({ data }) => data.featured)
const series = await getSubposts()
---

<Layout>
  <MetaPage slot="head" />
  <section class="intro" aria-labelledby="intro-title">
    <img
      src="/static/profile_picture.webp"
      alt="Ryan Batubara"
      width="512"
      height="512"
      fetchpriority="high"
    >
    <intro-copy>
      <intro-heading>
        <h1 id="intro-title">Hi, I'm Ryan!</h1>
        <p>rbatubara at ucsd.edu</p>
      </intro-heading>
      <p>
        I'm a
        <a href="https://cse.ucsd.edu/graduate/degree-programs/ms-program">
          Computer Science</a
        >
        Master's student at <a href="https://ucsd.edu/">UCSD</a>. I also
        completed by Bachelor's in
        <a
          href="https://math.ucsd.edu/students/undergraduate/ma30-math-computer-science-b-s/"
          >Math-CS</a
        >
        and
        <a href="https://datascience.ucsd.edu/">Data Science</a>
        at UCSD. I'm applying to PhD programs in Computer Science, specifically
        in
        <a
          href="https://math.ucsd.edu/sites/math.ucsd.edu/files/undergrad/honors-program/honors-theses/2025-2026/Batubara%2CRyan_Honors_Thesis.pdf"
          >Quantum Computing</a
        >. My other research interests include
        <a
          href="https://antsmath.org/ANTSXVII/papers/antsxvii-batubara_garzella_huang_mellberg-paper.pdf"
        >
          GPU-based computational algebra</a
        >
        and
        <a href="https://github.com/rybplayer/Talks">recreational math</a>.
      </p>
      <intro-actions>
        <document-links>
          <a
            class="document-link"
            href="https://github.com/rybplayer/CV/blob/2fe395833ebbd594804631cdd80e7852d25e82ae/RyanBatubaraCV.pdf"
            >CV</a
          >
          <a
            class="document-link"
            href="https://github.com/rybplayer/Resume/blob/main/RyanBatubaraResume.pdf"
            >Resume</a
          >
        </document-links>
        <SocialIcons links={SOCIALS} />
      </intro-actions>
    </intro-copy>
  </section>

  {featuredPublication && (
    <section class="listing" aria-labelledby="publication-title">
      <listing-heading>
        <h2 id="publication-title">Featured paper</h2>
        <a href="/publications/">See all publications →</a>
      </listing-heading>
      <ul>
        <PublicationCard publication={featuredPublication} />
      </ul>
    </section>
  )}

  {featuredPost && (
    <section class="listing" aria-labelledby="posts-title">
      <listing-heading>
        <h2 id="posts-title">Featured blog post</h2>
        <a href="/blog/">See all posts →</a>
      </listing-heading>
      <ul>
        <BlogCard
          post={featuredPost}
          entries={[
            featuredPost,
            ...(series.get(featuredPost.id) ?? []),
          ]}
        />
      </ul>
    </section>
  )}
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr;
    gap: var(--space-m);
    align-items: start;
  }

  .intro > img {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  intro-copy,
  intro-heading,
  intro-actions,
  listing-heading {
    display: flex;
  }

  intro-copy {
    flex-direction: column;
    gap: var(--space-s);
    color: var(--muted-foreground);
  }

  intro-heading {
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
  }

  h1 {
    color: var(--foreground);
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
  }

  intro-heading p,
  listing-heading a {
    font-size: var(--step--1);
  }

  intro-actions {
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    inline-size: 100%;
  }

  document-links {
    display: flex;
    gap: var(--space-2xs);
  }

  intro-actions :global(ul) {
    margin-inline-start: auto;
  }

  intro-copy > p a,
  .document-link {
    --underline: currentColor;
    color: inherit;
    font-weight: inherit;
  }

  .listing {
    margin-block-start: var(--space-m);
  }

  listing-heading {
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
  }

  h2 {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  @media (width < 32rem) {
    .intro {
      grid-template-columns: 6rem 1fr;
    }

    intro-copy {
      display: contents;
    }

    intro-copy > p,
    intro-actions {
      grid-column: 1 / -1;
    }
  }
</style>
