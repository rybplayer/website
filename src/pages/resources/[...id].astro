---
import MetaPost from "@/components/MetaPost.astro"
import PostActions from "@/components/PostActions.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesReader from "@/components/SeriesReader.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { getArticles, getSeries, pageTitle, readingTime } from "@/lib/content"
import { formatDate, isSubpost, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const resources = await getArticles("resources")
  const series = await getSeries("resources")
  return resources.flatMap((parent, index) => {
    const chain = [parent, ...(series.get(parent.id) ?? [])]
    return chain.map((resource) => ({
      params: { id: resource.id },
      props: {
        resource,
        chain,
        prev: resources[index + 1],
        next: resources[index - 1],
      },
    }))
  })
}

type Resource = CollectionEntry<"resources">
type Props = {
  resource: Resource
  chain: Resource[]
  prev?: Resource
  next?: Resource
}
const { resource, chain, prev, next } = Astro.props
const parent = chain[0]!
const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
  })),
)
const sections = rendered.map(({ entry, headings }, index) => ({
  id: index === 0 ? undefined : subpostSlug(entry.id),
  label: entry.data.title,
  open: entry.id === resource.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)
const crumbs = [{ label: parent.data.title, href: `/resources/${parent.id}` }]
if (isSubpost(resource.id))
  crumbs.push({ label: resource.data.title, href: `/resources/${resource.id}` })
---

<Layout crumbs={crumbs}>
  <MetaPost
    slot="head"
    post={resource}
    canonical={isSubpost(resource.id) ? `/resources/${parent.id}` : undefined}
  />
  {hasToc && <TableOfContents slot="toc" title={parent.data.title} sections={sections} />}
  <PostActions slot="actions" prev={prev} next={next} basePath="/resources" />
  <ScrollToTop floating />
  {rendered.map(({ entry, Content, authors }, index) => (
    <article id={index === 0 ? undefined : subpostSlug(entry.id)} data-url={`/resources/${entry.id}`} data-title={pageTitle(entry.data.title)} data-embedded={index > 0 || undefined}>
      <header>
        <h1>{entry.data.title}</h1>
        <post-meta>
          {authors.length > 0 && <span>{authors.map((author, authorIndex) => <>{authorIndex > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>)}</span>}
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>{readingTime(entry)}</span>
          {entry.data.tags?.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
        </post-meta>
        <p>{entry.data.description}</p>
        {entry.data.link && <a class="resource-link" href={entry.data.link}>Open resource ↗</a>}
      </header>
      {entry.data.image && <post-banner><Image src={entry.data.image} alt={entry.data.title} width={1200} height={630} priority={entry.id === resource.id || undefined} /></post-banner>}
      <prose-content><Content /></prose-content>
    </article>
  ))}
  {chain.length > 1 && <SeriesReader />}
</Layout>

<style>
  article[data-embedded] {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);
    scroll-margin-block-start: calc(-2px - 0.2 * var(--step-2));
  }
  article[data-embedded] header h1 {
    font-size: var(--step-2);
  }
  header {
    margin-block-end: var(--space-m);
  }
  header h1 {
    font-size: var(--step-3);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
  }
  header > p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
  post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
  post-meta > * + *::before {
    content: "·";
    margin-inline-end: var(--space-3xs);
  }
  .resource-link {
    display: inline-block;
    margin-block-start: var(--space-2xs);
  }
  post-banner {
    display: block;
    margin-block-end: var(--space-m);
    background-color: var(--accent);
  }
  post-banner :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
</style>
